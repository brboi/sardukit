# Sardukit - Vercel Environment Variables
# Set these via Vercel CLI or Dashboard:
#   vercel env add <KEY> <production|preview|development>
# Or via secrets for sensitive values:
#   vercel secrets add <name> <value>
#   then reference in vercel.json as @<name>

# === Required ===
# Google OAuth
GOOGLE_CLIENT_ID=          # Google OAuth Client ID (e.g. 123...apps.googleusercontent.com)

# Database
DATABASE_URL=              # Neon Postgres connection string (e.g. postgresql://...)

# Auth
JWT_SECRET=                # Secret for signing JWT tokens (generate: openssl rand -hex 32)

# Allowed emails (comma-separated, fallback if DB whitelist is empty)
ALLOWED_EMAILS=            # e.g. user@gmail.com,admin@gmail.com

# Gemini AI (optional, for rule suggestions)
GEMINI_API_KEY=            # Google Gemini API key
